    {
      "name": "get_booking",
      "title": "Get Booking by Reference",
      "description": "Retrieves a booking by its booking reference. Requires a valid Druk Asia API key (sent automatically via the `x-api-key` header).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "booking_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Booking reference (e.g. DA-26-X7K2PQ)."
          }
        },
        "required": [
          "booking_ref"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
