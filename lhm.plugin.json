    {
      "name": "list_festivals",
      "title": "List Festivals Calendar",
      "description": "Retrieves upcoming festivals in Bhutan for a specified year, with an optional filter for popular festivals. Requires a valid Druk Asia API key (sent automatically via the `x-api-key` header).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100,
            "description": "Calendar year to fetch festivals for (e.g. 2026)."
          },
          "ispopular": {
            "type": "string",
            "enum": [
              "true",
              "false",
              "1",
              "0"
            ],
            "description": "Filter popular festivals only: 'true', 'false', '1', or '0'."
          }
        },
        "required": [
          "year"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_itineraries",
      "title": "List & Price Tour Itineraries",
      "description": "Retrieves itineraries with daily breakdown, hotels, and activities, including dynamic quotation pricing based on party composition and optional filters. Requires a valid Druk Asia API key (sent automatically via the `x-api-key` header).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "adults": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of adult travelers (default 1)."
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of child travelers (default 0)."
          },
          "infants": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of infant travelers (default 0)."
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "description": "Filter itineraries by duration in days."
          },
          "itinerary_category": {
            "type": "string",
            "description": "Optional English itinerary category URL, e.g. 'cultural'."
          },
          "single_rooms": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of single rooms requested."
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_itinerary",
      "title": "Get Itinerary by ID",
      "description": "Retrieves a single itinerary by its numeric ID with day-by-day detail and pricing for one adult. Requires a valid Druk Asia API key (sent automatically via the `x-api-key` header).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "Positive numeric itinerary ID."
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "search_flights",
      "title": "Search Flights & Pricing",
      "description": "Searches live Drukair flight availability and calculates flight pricing for the party. Leave return_date empty for one-way. Requires a valid Druk Asia API key (sent automatically via the `x-api-key` header).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "departure_airport": {
            "type": "string",
            "minLength": 3,
            "maxLength": 4,
            "description": "Departure airport 3-letter IATA code (e.g. SIN, BKK, DEL, KTM)."
          },
          "arrival_airport": {
            "type": "string",
            "minLength": 3,
            "maxLength": 4,
            "description": "Arrival airport 3-letter IATA code (e.g. PBH)."
          },
          "departure_date": {
            "type": "string",
            "description": "Departure date YYYY-MM-DD (default 2026-12-01)."
          },
          "return_date": {
            "type": "string",
            "description": "Return date YYYY-MM-DD (default 2026-12-07). Omit for one-way."
          },
          "adults": {
            "type": "integer",
            "minimum": 1,
            "description": "Adult passengers (default 1)."
          },
          "children": {
            "type": "integer",
            "minimum": 0,
            "description": "Child passengers (default 0)."
          },
          "infants": {
            "type": "integer",
            "minimum": 0,
            "description": "Infant passengers (default 0)."
          }
        },
        "required": [
          "departure_airport",
          "arrival_airport"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "list_destinations",
      "title": "List Destinations",
      "description": "Returns destination IDs and titles for use as port_entry_id and port_exit_id in bookings. isEntry and isExit indicate whether a destination can be used for entry or exit. Requires a valid Druk Asia API key (sent automatically via the `x-api-key` header).",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "create_member",
      "title": "Create Member",
      "description": "Creates a member using contact details. IsActive and Status are always set to true by the API. Requires a valid Druk Asia API key (sent automatically via the `x-api-key` header).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Member email address."
          },
          "fullname": {
            "type": "string",
            "minLength": 1,
            "description": "Member full name."
          },
          "phone_country_code": {
            "type": "string",
            "minLength": 1,
            "description": "Phone country code, e.g. +975."
          },
          "phone_number": {
            "type": "string",
            "minLength": 1,
            "description": "Phone number, e.g. 17123456."
          }
        },
        "required": [
          "email",
          "fullname",
          "phone_country_code",
          "phone_number"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "get_member",
      "title": "Get Member by ID",
