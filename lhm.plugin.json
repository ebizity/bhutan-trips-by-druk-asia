    {
      "name": "create_payment",
      "title": "Create Airwallex Payment",
      "description": "Creates a payment for a booking via Airwallex. For payment_type 'auto_fill' the card details are required; for 'payment_link' a shareable payment URL is returned. Requires a valid Druk Asia API key (sent automatically via the `x-api-key` header).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "online_booking_id": {
            "type": "string",
            "minLength": 1,
            "description": "OnlineBookings.Id (booking_id from create_booking)."
          },
          "booking_ref_code": {
            "type": "string",
            "minLength": 1,
            "description": "Booking reference code, e.g. DA-26-X7K2PQ."
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Payment amount in USD."
          },
          "payment_type": {
            "type": "string",
            "enum": [
              "auto_fill",
              "payment_link"
            ],
            "description": "auto_fill charges a card directly; payment_link generates a payment URL."
          },
          "card_number": {
            "type": "string",
            "description": "Card number (required for auto_fill)."
          },
          "expiry_month": {
            "type": "string",
            "description": "Card expiry month (required for auto_fill)."
          },
          "expiry_year": {
            "type": "string",
            "description": "Card expiry year (required for auto_fill)."
          },
          "cvc": {
            "type": "string",
            "description": "Card CVC (required for auto_fill)."
          },
          "name": {
            "type": "string",
            "description": "Cardholder name (required for auto_fill)."
          }
        },
        "required": [
          "online_booking_id",
          "booking_ref_code",
          "amount",
          "payment_type"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
