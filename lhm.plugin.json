    {
      "name": "create_booking",
      "title": "Create Booking",
      "description": "Creates a booking and returns the generated booking reference and ID. A member ID must already exist (see create_member), and port_entry_id / port_exit_id must reference valid destinations (see list_destinations). Requires a valid Druk Asia API key (sent automatically via the `x-api-key` header).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "itinerary_id": {
            "type": "integer",
            "description": "Numeric itinerary ID (from list_itineraries or get_itinerary)."
          },
          "tour_start_date": {
            "type": "string",
            "description": "Tour start date in ISO date-time format, e.g. 2026-12-01T00:00:00.000Z."
          },
          "tour_end_date": {
            "type": "string",
            "description": "Tour end date in ISO date-time format, e.g. 2026-12-07T00:00:00.000Z."
          },
          "port_entry_id": {
            "type": "integer",
            "description": "Arrival port Destination.Id. Must reference a destination where isEntry = 1. See list_destinations."
          },
          "port_exit_id": {
            "type": "integer",
            "description": "Departure port Destination.Id. Must reference a destination where isExit = 1. See list_destinations."
          },
          "member_id": {
            "type": "string",
            "description": "Member ID. Create one first with create_member if not done yet."
          },
          "total_adult_pax": {
            "type": "integer",
            "description": "Total adult passengers."
          },
          "total_child_pax": {
            "type": "integer",
            "description": "Total child passengers."
          },
          "total_infant_pax": {
            "type": "integer",
            "description": "Total infant passengers."
          },
          "total_adult_air_ticket": {
            "type": "integer",
            "description": "Total adult air tickets."
          },
          "total_child_air_ticket": {
            "type": "integer",
            "description": "Total child air tickets."
          },
          "total_infant_air_ticket": {
            "type": "integer",
            "description": "Total infant air tickets."
          },
          "is_trekking_group": {
            "type": "boolean",
            "description": "Whether this booking is a trekking group."
          },
          "single_supplement_cost": {
            "type": "number",
            "description": "Single room supplement cost."
          },
          "trekking_cost": {
            "type": "number",
            "description": "Trekking cost."
          },
          "total_visa_cost": {
            "type": "number",
            "description": "Total visa cost."
          },
          "total_land_tour_price": {
            "type": "number",
            "description": "Total land tour price."
          },
          "credit_card_charge": {
            "type": "number",
            "description": "Credit card processing charge."
          },
          "total_air_ticket_price": {
            "type": "number",
            "description": "Total air ticket price."
          },
          "grand_total": {
            "type": "number",
            "description": "Grand total amount."
          }
        },
        "required": [
          "itinerary_id",
          "tour_start_date",
          "tour_end_date",
          "port_entry_id",
          "port_exit_id",
          "member_id",
          "total_adult_pax",
          "total_child_pax",
          "total_infant_pax",
          "total_adult_air_ticket",
          "total_child_air_ticket",
          "total_infant_air_ticket",
          "is_trekking_group",
          "single_supplement_cost",
          "trekking_cost",
          "total_visa_cost",
          "total_land_tour_price",
          "credit_card_charge",
          "total_air_ticket_price",
          "grand_total"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
